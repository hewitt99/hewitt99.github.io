---
import BaseLayout from './BaseLayout.astro'
import { formatDate } from '../utils'

export interface Props {
	frontmatter: {
		title: string
		description: string
		publishDate: string
		updatedDate?: string
		heroImage?: string
		category: string
		tags: string[]
		author?: string
	}
	readingTime?: number
	wordCount?: number
	noteEntry?: {
		slug: string
		updatedDate?: string
		title?: string
	}
}

const { frontmatter, readingTime, wordCount, noteEntry } = Astro.props
const publishDate = new Date(frontmatter.publishDate)
const updatedDate = frontmatter.updatedDate ? new Date(frontmatter.updatedDate) : null
const noteUpdated = noteEntry?.updatedDate ? new Date(noteEntry.updatedDate) : null
---

<BaseLayout
	title={frontmatter.title}
	description={frontmatter.description}
	image={frontmatter.heroImage}
	article={true}
>
	<div class='mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8'>
		<div class='lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_16rem]'>
			<article class='min-w-0'>
				<header class='reveal mb-8' style='--delay: 0ms'>
					<div class='mb-3 text-sm text-muted-foreground'>
						<a
							href={`/categories/${frontmatter.category}`}
							class='cursor-pointer transition-colors duration-150 hover:text-accent'
						>
							{frontmatter.category}
						</a>
					</div>

					<h1 class='mb-4 text-3xl font-semibold leading-tight tracking-tight text-foreground md:text-4xl'>
						{frontmatter.title}
					</h1>

					<div class='mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground'>
						<time datetime={publishDate.toISOString()}>发布于 {formatDate(publishDate)}</time>
						{
							updatedDate && (
								<time datetime={updatedDate.toISOString()}>更新于 {formatDate(updatedDate)}</time>
							)
						}
						{frontmatter.author && <span>{frontmatter.author}</span>}
						{readingTime && <span class='font-mono'>{readingTime} 分钟</span>}
						{wordCount && <span class='font-mono'>{wordCount.toLocaleString()} 字</span>}
					</div>

					{
						frontmatter.tags.length > 0 && (
							<div class='mb-6 flex flex-wrap gap-1.5'>
								{frontmatter.tags.map((tag) => (
									<a href={`/tags/${tag}`} class='tag'>
										#{tag}
									</a>
								))}
							</div>
						)
					}

					{
						frontmatter.heroImage && (
							<img
								src={frontmatter.heroImage}
								alt={frontmatter.title}
								class='mb-2 h-52 w-full rounded-lg border border-border object-cover md:h-72'
							/>
						)
					}
				</header>

				<!-- Mobile TOC -->
				<details
					data-toc-wrap
					class='reveal mb-8 rounded-lg border border-border bg-card p-4 lg:hidden'
					style='--delay: 40ms'
				>
					<summary class='cursor-pointer text-sm font-medium text-foreground'>本页目录</summary>
					<nav class='toc-list mt-3 flex flex-col gap-0.5' aria-label='本页目录'></nav>
				</details>

				<div class='prose-custom max-w-3xl'>
					<slot />
				</div>

				{
					noteEntry && (
						<aside class='mt-10 max-w-3xl border-t border-border pt-6 text-sm text-muted-foreground'>
							<p>
								<span class='text-foreground'>碎碎念</span>
								{noteUpdated && (
									<>
										{' · '}
										<time datetime={noteUpdated.toISOString()}>
											更新于 {formatDate(noteUpdated)}
										</time>
									</>
								)}
								{' · '}
								<a
									href={`/notes/${noteEntry.slug}`}
									class='text-accent transition-colors duration-150 hover:underline'
								>
									查看阅读笔记
								</a>
							</p>
						</aside>
					)
				}

				<footer class='mt-12 max-w-3xl border-t border-border pt-8'>
					<div class='flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center'>
						{
							frontmatter.tags.length > 0 && (
								<div>
									<h3 class='mb-2 text-sm font-medium text-foreground'>标签</h3>
									<div class='flex flex-wrap gap-1.5'>
										{frontmatter.tags.map((tag) => (
											<a href={`/tags/${tag}`} class='tag'>
												#{tag}
											</a>
										))}
									</div>
								</div>
							)
						}
						<div>
							<h3 class='mb-2 text-sm font-medium text-foreground'>分享</h3>
							<button
								id='share-button'
								type='button'
								class='cursor-pointer rounded-md border border-border p-2 text-muted-foreground transition-colors duration-150 hover:border-accent/40 hover:text-accent'
								aria-label='分享'
							>
								<svg class='h-5 w-5' fill='currentColor' viewBox='0 0 24 24'>
									<path
										d='M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z'
									></path>
								</svg>
							</button>
						</div>
					</div>
				</footer>
			</article>

			<!-- Desktop TOC -->
			<aside class='relative hidden lg:block' data-toc-wrap>
				<div class='sticky top-24'>
					<p class='mb-3 text-xs font-medium uppercase tracking-wide text-muted-foreground'>本页目录</p>
					<nav class='toc-list flex max-h-[70vh] flex-col gap-0.5 overflow-y-auto' aria-label='本页目录'
					></nav>
					{
						frontmatter.tags.length > 0 && (
							<div class='mt-8 border-t border-border pt-6'>
								<p class='mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground'>
									标签
								</p>
								<div class='flex flex-wrap gap-1.5'>
									{frontmatter.tags.map((tag) => (
										<a href={`/tags/${tag}`} class='tag'>
											#{tag}
										</a>
									))}
								</div>
							</div>
						)
					}
				</div>
			</aside>
		</div>
	</div>

	<button
		id='back-to-top'
		class='invisible fixed bottom-8 right-8 z-50 cursor-pointer rounded-md bg-accent p-3 text-accent-foreground opacity-0 shadow-lg transition-opacity duration-200 hover:opacity-90'
		aria-label='回到顶部'
	>
		<svg class='h-5 w-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
			<path
				stroke-linecap='round'
				stroke-linejoin='round'
				stroke-width='2'
				d='M5 10l7-7m0 0l7 7m-7-7v18'></path>
		</svg>
	</button>
</BaseLayout>

<script>
	import { initToc } from '../scripts/toc'
	import { initReveals } from '../scripts/motion'

	initToc()
	initReveals()

	const backToTopButton = document.getElementById('back-to-top')
	window.addEventListener(
		'scroll',
		() => {
			if (window.scrollY > 300) {
				backToTopButton?.classList.remove('opacity-0', 'invisible')
				backToTopButton?.classList.add('opacity-100', 'visible')
			} else {
				backToTopButton?.classList.add('opacity-0', 'invisible')
				backToTopButton?.classList.remove('opacity-100', 'visible')
			}
		},
		{ passive: true }
	)

	backToTopButton?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: 'smooth' })
	})

	document.getElementById('share-button')?.addEventListener('click', () => {
		if (navigator.share) {
			navigator.share({ title: document.title, url: window.location.href })
		} else {
			window.open(
				`https://twitter.com/intent/tweet?text=${encodeURIComponent(document.title)}&url=${encodeURIComponent(window.location.href)}`,
				'_blank'
			)
		}
	})
</script>
