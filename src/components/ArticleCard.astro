---
import type { BlogPost } from '../types'
import { formatDate } from '../utils'

export interface Props {
	post: BlogPost
	featured?: boolean
}

const { post, featured = false } = Astro.props

const articleClass = featured
	? 'card flex h-full flex-col p-6 md:p-8'
	: 'card flex h-full flex-col p-6'

const imageWrapClass = featured
	? '-mx-6 -mt-6 mb-4 md:-mx-8 md:-mt-8'
	: '-mx-6 -mt-6 mb-4'

const imageClass = featured
	? 'h-56 w-full rounded-t-lg object-cover md:h-72'
	: 'h-48 w-full rounded-t-lg object-cover'

const titleClass = featured
	? 'mb-3 line-clamp-2 text-2xl font-bold text-foreground md:text-3xl'
	: 'mb-3 line-clamp-2 text-xl font-bold text-foreground'

const descriptionClass = featured
	? 'mb-4 line-clamp-4 flex-grow text-muted-foreground'
	: 'mb-4 line-clamp-3 flex-grow text-muted-foreground'
---

<article class={articleClass}>
	{
		post.heroImage && (
			<div class={imageWrapClass}>
				<img
					src={post.heroImage}
					alt={post.title}
					class={imageClass}
					loading={featured ? 'eager' : 'lazy'}
				/>
			</div>
		)
	}

	<div class='mb-3 flex items-center gap-2'>
		{
			featured && (
				<span class='rounded-md border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent'>
					最新
				</span>
			)
		}
		<a
			href={`/categories/${post.category}`}
			class='inline-block cursor-pointer rounded-md border border-border bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground transition-colors duration-200 hover:border-accent/40'
		>
			{post.category}
		</a>
	</div>

	<h2 class={titleClass}>
		<a
			href={`/blog/${post.slug}`}
			class='cursor-pointer transition-colors duration-200 hover:text-accent'
		>
			{post.title}
		</a>
	</h2>

	<p class={descriptionClass}>
		{post.description}
	</p>

	{
		post.tags.length > 0 && (
			<div class='mb-4'>
				<div class='flex flex-wrap gap-2'>
					{post.tags.slice(0, 3).map((tag) => (
						<a href={`/tags/${tag}`} class='tag text-xs'>
							#{tag}
						</a>
					))}
					{post.tags.length > 3 && (
						<span class='text-xs text-muted-foreground'>
							+{post.tags.length - 3} more
						</span>
					)}
				</div>
			</div>
		)
	}

	<div class='mt-auto flex items-center justify-between text-sm text-muted-foreground'>
		<div class='flex flex-wrap items-center gap-x-4 gap-y-1'>
			<time datetime={post.publishDate.toISOString()}>
				{formatDate(post.publishDate)}
			</time>

			{
				post.readingTime && (
					<span class='flex items-center'>
						<svg class='mr-1 h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
							<path
								stroke-linecap='round'
								stroke-linejoin='round'
								stroke-width='2'
								d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'
							/>
						</svg>
						{post.readingTime} 分钟
					</span>
				)
			}

			{
				post.wordCount && (
					<span class='flex items-center'>
						<svg class='mr-1 h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
							<path
								stroke-linecap='round'
								stroke-linejoin='round'
								stroke-width='2'
								d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
							/>
						</svg>
						{post.wordCount.toLocaleString()} 字
					</span>
				)
			}
		</div>
	</div>
</article>

<style>
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.line-clamp-4 {
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
