---
export interface Props {
	currentPage: number
	totalPages: number
	hasNext: boolean
	hasPrev: boolean
	nextPage: number | null
	prevPage: number | null
	baseUrl?: string
}

const { currentPage, totalPages, hasNext, hasPrev, nextPage, prevPage, baseUrl = '' } = Astro.props

const pageLinkClass =
	'flex items-center rounded-md border border-border bg-card px-3 py-2 text-sm font-medium text-muted-foreground transition-colors duration-200 hover:bg-secondary hover:text-foreground cursor-pointer'
const pageDisabledClass =
	'flex items-center rounded-md border border-border bg-card px-3 py-2 text-sm font-medium text-muted-foreground/50 cursor-not-allowed'
const pageNumberClass =
	'rounded-md border border-border bg-card px-3 py-2 text-sm font-medium text-muted-foreground transition-colors duration-200 hover:bg-secondary hover:text-foreground cursor-pointer'

function getPageNumbers(current: number, total: number) {
	const pages: (number | string)[] = []

	if (total <= 7) {
		for (let i = 1; i <= total; i++) {
			pages.push(i)
		}
	} else {
		pages.push(1)

		if (current <= 4) {
			for (let i = 2; i <= 5; i++) {
				pages.push(i)
			}
			pages.push('...')
			pages.push(total)
		} else if (current >= total - 3) {
			pages.push('...')
			for (let i = total - 4; i <= total; i++) {
				pages.push(i)
			}
		} else {
			pages.push('...')
			for (let i = current - 1; i <= current + 1; i++) {
				pages.push(i)
			}
			pages.push('...')
			pages.push(total)
		}
	}

	return pages
}

const pageNumbers = getPageNumbers(currentPage, totalPages)
---

{
	totalPages > 1 && (
		<nav class='mt-8 flex items-center justify-center space-x-2' aria-label='分页导航'>
			{hasPrev ? (
				<a
					href={prevPage === 1 ? baseUrl || '/' : `${baseUrl}/page/${prevPage}`}
					class={pageLinkClass}
					aria-label='上一页'
				>
					<svg class='mr-1 h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
						<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' />
					</svg>
					上一页
				</a>
			) : (
				<span class={pageDisabledClass}>
					<svg class='mr-1 h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
						<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' />
					</svg>
					上一页
				</span>
			)}

			<div class='flex space-x-1'>
				{pageNumbers.map((page) =>
					page === '...' ? (
						<span class='px-3 py-2 text-sm font-medium text-muted-foreground'>...</span>
					) : page === currentPage ? (
						<span class='cursor-default rounded-md border border-accent bg-accent px-3 py-2 text-sm font-medium text-accent-foreground'>
							{page}
						</span>
					) : (
						<a
							href={page === 1 ? baseUrl || '/' : `${baseUrl}/page/${page}`}
							class={pageNumberClass}
							aria-label={`第 ${page} 页`}
						>
							{page}
						</a>
					)
				)}
			</div>

			{hasNext ? (
				<a href={`${baseUrl}/page/${nextPage}`} class={pageLinkClass} aria-label='下一页'>
					下一页
					<svg class='ml-1 h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
						<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7' />
					</svg>
				</a>
			) : (
				<span class={pageDisabledClass}>
					下一页
					<svg class='ml-1 h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
						<path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7' />
					</svg>
				</span>
			)}
		</nav>
	)
}
