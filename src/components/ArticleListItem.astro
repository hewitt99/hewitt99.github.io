---
import type { BlogPost } from '../types'
import { formatDate } from '../utils'

export interface Props {
	post: BlogPost
	featured?: boolean
	delay?: number
}

const { post, featured = false, delay = 0 } = Astro.props
---

{
	featured ? (
		<a
			href={`/blog/${post.slug}`}
			class='list-row reveal group mb-6 flex flex-col gap-4 sm:flex-row sm:items-stretch'
			style={`--delay: ${delay}ms`}
		>
			{post.heroImage && (
				<div class='sm:w-56 md:w-64 flex-shrink-0 overflow-hidden rounded-md'>
					<img
						src={post.heroImage}
						alt={post.title}
						class='h-40 w-full object-cover sm:h-full sm:min-h-[9rem]'
						loading='eager'
					/>
				</div>
			)}
			<div class='flex min-w-0 flex-1 flex-col'>
				<div class='mb-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground'>
					<span class='font-mono text-accent'>最新</span>
					<span>·</span>
					<span>{post.category}</span>
					<span>·</span>
					<time datetime={post.publishDate.toISOString()}>{formatDate(post.publishDate)}</time>
				</div>
				<h2 class='mb-2 text-xl font-semibold text-foreground transition-colors duration-150 group-hover:text-accent md:text-2xl'>
					{post.title}
				</h2>
				<p class='line-clamp-3 flex-grow text-sm text-muted-foreground md:text-base'>
					{post.description}
				</p>
				{(post.readingTime || post.wordCount) && (
					<div class='mt-3 flex gap-3 font-mono text-xs text-muted-foreground'>
						{post.readingTime && <span>{post.readingTime} 分钟</span>}
						{post.wordCount && <span>{post.wordCount.toLocaleString()} 字</span>}
					</div>
				)}
			</div>
		</a>
	) : (
		<a
			href={`/blog/${post.slug}`}
			class='list-row reveal group'
			style={`--delay: ${delay}ms`}
		>
			<div class='mb-1.5 flex flex-wrap items-center gap-2 text-xs text-muted-foreground'>
				<span class='transition-colors duration-150 group-hover:text-accent'>{post.category}</span>
				<span>·</span>
				<time datetime={post.publishDate.toISOString()}>{formatDate(post.publishDate)}</time>
				{post.readingTime && (
					<>
						<span>·</span>
						<span class='font-mono'>{post.readingTime} 分钟</span>
					</>
				)}
			</div>
			<h2 class='mb-1.5 text-lg font-semibold text-foreground transition-colors duration-150 group-hover:text-accent'>
				{post.title}
			</h2>
			<p class='line-clamp-2 text-sm text-muted-foreground'>{post.description}</p>
			{post.tags.length > 0 && (
				<div class='mt-3 flex flex-wrap gap-1.5'>
					{post.tags.slice(0, 4).map((tag) => (
						<span class='tag pointer-events-none'>#{tag}</span>
					))}
				</div>
			)}
		</a>
	)
}

<style>
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
