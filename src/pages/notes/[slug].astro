---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatDate } from '../../utils'
import { getBuildableNotes, noteSlug, normalizeVisibility } from '../../utils/notes'

export function getStaticPaths() {
	return getBuildableNotes().map((note) => {
		const slug = noteSlug(note)
		return {
			params: { slug },
			props: { note, slug }
		}
	})
}

const { note, slug } = Astro.props
const { Content, frontmatter } = note
const visibility = normalizeVisibility(frontmatter?.visibility)
const title = frontmatter?.title || `碎碎念 · ${slug}`
const updatedDate = frontmatter?.updatedDate ? new Date(frontmatter.updatedDate) : null
---

<BaseLayout title={title} description={`关于文章 ${slug} 的碎碎念`} article={true}>
	<div class='mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8'>
		<header class='mb-8'>
			<p class='mb-3 text-sm text-muted-foreground'>
				<a href={`/blog/${slug}`} class='transition-colors duration-150 hover:text-accent'>
					← 返回原文
				</a>
			</p>
			<h1 class='mb-3 text-3xl font-semibold leading-tight tracking-tight text-foreground md:text-4xl'>
				{title}
			</h1>
			<div class='flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground'>
				{
					updatedDate && (
						<time datetime={updatedDate.toISOString()}>更新于 {formatDate(updatedDate)}</time>
					)
				}
				{
					visibility === 'private' && (
						<span class='font-mono text-xs uppercase tracking-wide'>本地预览 · private</span>
					)
				}
			</div>
		</header>

		<div class='prose-custom max-w-3xl'>
			<Content />
		</div>
	</div>
</BaseLayout>
