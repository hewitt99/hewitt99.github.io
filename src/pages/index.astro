---
import BaseLayout from '../layouts/BaseLayout.astro'
import ArticleListItem from '../components/ArticleListItem.astro'
import Pagination from '../components/Pagination.astro'
import { processPostData, paginate } from '../utils'
import { SITE_CONFIG } from '../config'

const allPosts = Object.values(import.meta.glob('../content/blog/*.{md,mdx}', { eager: true }))
const posts = await processPostData(allPosts)

const currentPage = 1
const paginatedPosts = paginate(posts, currentPage, SITE_CONFIG.postsPerPage)

const pagePosts = paginatedPosts.data
const featuredPost = pagePosts[0]
const gridPosts = pagePosts.slice(1)
const categoryCount = new Set(posts.map((post) => post.category)).size
const tagCount = new Set(posts.flatMap((post) => post.tags)).size
---

<BaseLayout>
	<div class='mx-auto max-w-3xl px-4 py-8 sm:px-6 md:py-10 lg:px-8'>
		<section class='reveal mb-6' style='--delay: 0ms'>
			<h1 class='mb-2 text-2xl font-semibold tracking-tight text-foreground md:text-3xl'>
				欢迎来到我的博客
			</h1>
			<p class='max-w-2xl text-base text-muted-foreground'>{SITE_CONFIG.description}</p>
		</section>

		<p class='reveal mb-8 text-sm text-muted-foreground' style='--delay: 40ms' aria-label='博客统计'>
			<span class='font-mono text-foreground'>{posts.length}</span> 篇文章 ·
			<span class='font-mono text-foreground'>{categoryCount}</span> 个分类 ·
			<span class='font-mono text-foreground'>{tagCount}</span> 个标签
		</p>

		<section>
			<div class='mb-5 flex items-center justify-between gap-4'>
				<h2 class='text-lg font-semibold text-foreground md:text-xl'>最新文章</h2>
				{
					paginatedPosts.totalPages > 1 && (
						<a
							href='/page/2'
							class='cursor-pointer text-sm text-accent transition-colors duration-150 hover:underline'
						>
							查看更多 →
						</a>
					)
				}
			</div>

			{
				featuredPost ? (
					<>
						<ArticleListItem post={featuredPost} featured delay={80} />

						{gridPosts.length > 0 && (
							<ul class='mb-10 space-y-3'>
								{gridPosts.map((post, index) => (
									<li>
										<ArticleListItem post={post} delay={120 + index * 50} />
									</li>
								))}
							</ul>
						)}

						<Pagination
							currentPage={paginatedPosts.currentPage}
							totalPages={paginatedPosts.totalPages}
							hasNext={paginatedPosts.hasNext}
							hasPrev={paginatedPosts.hasPrev}
							nextPage={paginatedPosts.nextPage}
							prevPage={paginatedPosts.prevPage}
						/>
					</>
				) : (
					<div class='py-16 text-center'>
						<h3 class='mb-2 text-xl font-medium text-foreground'>暂无文章</h3>
						<p class='text-muted-foreground'>还没有发布任何文章，请稍后再来查看。</p>
					</div>
				)
			}
		</section>
	</div>
</BaseLayout>

<script>
	import { initReveals } from '../scripts/motion'
	initReveals()
</script>
